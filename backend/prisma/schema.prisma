datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  PAID_LEAVE
  UNPAID_LEAVE
  WEEKLY_OFF
  HOLIDAY
}

enum SalaryType {
  MONTHLY
  DAILY
  HOURLY
  WEEKLY
  PIECE_RATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  REVIEWED
  LOCKED
  PAID
}

enum PaymentMode {
  BANK_TRANSFER
  CASH
  UPI
  CHEQUE
}

enum CashBookType {
  CASH_IN
  CASH_OUT
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  phone        String?          @unique
  name         String
  password     String
  avatar       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  businesses   BusinessMember[]
  auditLogs    AuditLog[]
  approvals    Approval[]       @relation("ActionBy")
  notifications Notification[]
}

model Business {
  id              String           @id @default(uuid())
  name            String
  code            String?          @unique
  category        String?          @default("General") // Shop, Factory, School, Restaurant, Hospital, Office
  address         String?
  city            String?          @default("Ludhiana")
  state           String?          @default("Punjab")
  pincode         String?
  phone           String?
  email           String?
  logo            String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  statementName   String?
  kybStatus       String?          @default("VERIFIED") // 100% Free - pre-approved
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  members         BusinessMember[]
  departments     Department[]
  branches        Branch[]
  shifts          Shift[]
  employees       Employee[]
  salaryStructures SalaryStructure[]
  workRateCards   WorkRateCard[]
  dailyWorkEntries DailyWorkEntry[]
  attendanceRecords Attendance[]
  leaveRequests   LeaveRequest[]
  holidays        Holiday[]
  payrollPeriods  PayrollPeriod[]
  advances        Advance[]
  cashBooks       CashBook[]
  broadcasts      BroadcastMessage[]
  notifications   Notification[]
  approvals       Approval[]
  performanceReviews PerformanceReview[]
  performanceGoals   PerformanceGoal[]
  auditLogs       AuditLog[]
  geoLocations    GeoLocation[]
  automationRules AutomationRule[]
}

model BusinessMember {
  id         String   @id @default(uuid())
  businessId String
  userId     String
  role       Role     @default(ADMIN)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

model Department {
  id          String     @id @default(uuid())
  businessId  String
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employees   Employee[]
}

model Branch {
  id          String        @id @default(uuid())
  businessId  String
  name        String
  address     String?
  latitude    Float?
  longitude   Float?
  radiusMeters Float?       @default(200)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employees   Employee[]
  geoLocations GeoLocation[]
}

model Shift {
  id          String     @id @default(uuid())
  businessId  String
  name        String     // General 9-5, Morning, Night, Rotational
  startTime   String     // "09:00"
  endTime     String     // "18:00"
  graceMinutes Int       @default(15)
  halfDayHours Float     @default(4.5)
  fullDayHours Float     @default(8.5)
  isOvernight  Boolean   @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employees   Employee[]
  attendance  Attendance[]
}

model Employee {
  id               String            @id @default(uuid())
  businessId       String
  empCode          String
  name             String
  phone            String?
  email            String?
  designation      String?
  departmentId     String?
  branchId         String?
  shiftId          String?
  joiningDate      DateTime          @default(now())
  exitDate         DateTime?
  status           String            @default("ACTIVE") // ACTIVE, INACTIVE, TERMINATED
  salaryType       SalaryType        @default(MONTHLY)
  baseSalary       Float             @default(0) // Monthly rate, Daily rate, Hourly wage, etc.
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  panNumber        String?
  aadhaarNumber    String?
  address          String?
  emergencyContact String?
  faceData         String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  shift            Shift?            @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  salaryStructure  SalaryStructure?

  attendance       Attendance[]
  leaveRequests    LeaveRequest[]
  advances         Advance[]
  dailyWorkEntries DailyWorkEntry[]
  payrollItems     PayrollItem[]
  performanceReviews PerformanceReview[]
  performanceGoals   PerformanceGoal[]

  @@unique([businessId, empCode])
}

model SalaryStructure {
  id             String    @id @default(uuid())
  businessId     String
  employeeId     String    @unique
  basicPay       Float     @default(0)
  hra            Float     @default(0)
  da             Float     @default(0)
  specialAllow   Float     @default(0)
  bonus          Float     @default(0)
  epfDeduction   Float     @default(0)
  esiDeduction   Float     @default(0)
  profTax        Float     @default(0)
  otherDeductions Float    @default(0)
  overtimeHourlyRate Float @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model WorkRateCard {
  id          String     @id @default(uuid())
  businessId  String
  itemName    String     // e.g., "Shirt Stitching", "Bag Packing", "Brick Making"
  unit        String     // e.g., "Piece", "Kg", "Box", "Meter"
  ratePerUnit Float      @default(0)
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries     DailyWorkEntry[]
}

model DailyWorkEntry {
  id             String       @id @default(uuid())
  businessId     String
  employeeId     String
  workRateCardId String
  date           DateTime     @default(now())
  unitsCompleted Float        @default(0)
  totalAmount    Float        @default(0)
  remarks        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workRateCard   WorkRateCard @relation(fields: [workRateCardId], references: [id], onDelete: Cascade)
}

model Attendance {
  id           String           @id @default(uuid())
  businessId   String
  employeeId   String
  shiftId      String?
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  checkInTime  DateTime?
  checkOutTime DateTime?
  lateMinutes  Int              @default(0)
  earlyMinutes Int              @default(0)
  overtimeHours Float           @default(0)
  workHours    Float            @default(0)
  punchMethod  String           @default("MANUAL") // MANUAL, GEO, BIOMETRIC, QR
  latitudeIn   Float?
  longitudeIn  Float?
  latitudeOut  Float?
  longitudeOut Float?
  notes        String?
  isVerified   Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift        Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([businessId, employeeId, date])
}

model LeaveRequest {
  id          String      @id @default(uuid())
  businessId  String
  employeeId  String
  leaveType   String      // CASUAL, SICK, PRIVILEGE, MATERNITY, UNPAID
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  daysCount   Float       @default(1)
  reason      String?
  status      LeaveStatus @default(PENDING)
  actionNotes String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Holiday {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  date        DateTime  @db.Date
  isRecurring Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}

model AutomationRule {
  id             String   @id @default(uuid())
  businessId     String
  name           String   // Late Mark penalty, Overtime auto calculate, Auto half day
  ruleType       String   // LATE_PENALTY, AUTO_HALF_DAY, OVERTIME_CALC, AUTO_PRESENT
  parametersJson String   @db.Text
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model PayrollPeriod {
  id          String        @id @default(uuid())
  businessId  String
  title       String        // e.g. "October 2026", "Week 41 - Oct 2026"
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  status      PayrollStatus @default(DRAFT)
  totalGross  Float         @default(0)
  totalDeduct Float         @default(0)
  totalNet    Float         @default(0)
  lockedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       PayrollItem[]
}

model PayrollItem {
  id              String        @id @default(uuid())
  payrollPeriodId String
  employeeId      String
  totalDays       Float         @default(0)
  presentDays     Float         @default(0)
  halfDays        Float         @default(0)
  paidLeaves      Float         @default(0)
  absentDays      Float         @default(0)
  payableDays     Float         @default(0)
  overtimeHours   Float         @default(0)
  overtimePay     Float         @default(0)
  baseEarnings    Float         @default(0)
  pieceRatePay    Float         @default(0)
  allowances      Float         @default(0)
  bonuses         Float         @default(0)
  arrears         Float         @default(0)
  grossSalary     Float         @default(0)
  epfDeduction    Float         @default(0)
  esiDeduction    Float         @default(0)
  taxDeduction    Float         @default(0)
  advanceDeduction Float        @default(0)
  otherDeductions Float         @default(0)
  totalDeductions Float         @default(0)
  netPayable      Float         @default(0)
  status          String        @default("PENDING") // PENDING, PAID
  paymentDate     DateTime?
  paymentMode     PaymentMode?
  paymentRef      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payments        PaymentRecord[]

  @@unique([payrollPeriodId, employeeId])
}

model Advance {
  id             String          @id @default(uuid())
  businessId     String
  employeeId     String
  amount         Float
  repaidAmount   Float           @default(0)
  remainingAmount Float          @default(0)
  disbursedDate  DateTime        @default(now())
  reason         String?
  isSettled      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  repayments     Repayment[]
}

model Repayment {
  id          String      @id @default(uuid())
  advanceId   String
  amount      Float
  date        DateTime    @default(now())
  source      String      @default("PAYROLL") // PAYROLL, CASH, DIRECT
  notes       String?
  createdAt   DateTime    @default(now())

  advance     Advance     @relation(fields: [advanceId], references: [id], onDelete: Cascade)
}

model PaymentRecord {
  id            String      @id @default(uuid())
  payrollItemId String
  amount        Float
  mode          PaymentMode @default(BANK_TRANSFER)
  referenceNo   String?
  paymentDate   DateTime    @default(now())
  notes         String?
  createdAt     DateTime    @default(now())

  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
}

model CashBook {
  id          String       @id @default(uuid())
  businessId  String
  type        CashBookType @default(CASH_IN)
  amount      Float
  category    String       // Salary, Petty Cash, Sales, Vendor, Office Supply, Tea/Snacks, Travel
  description String?
  paymentMode PaymentMode  @default(CASH)
  date        DateTime     @default(now())
  receiptUrl  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BroadcastMessage {
  id         String   @id @default(uuid())
  businessId String
  title      String
  message    String   @db.Text
  targetRole String   @default("ALL") // ALL, STAFF, MANAGER
  sentAt     DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  title      String
  content    String
  type       String   @default("SYSTEM") // ATTENDANCE, LEAVE, PAYROLL, SYSTEM
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Approval {
  id          String         @id @default(uuid())
  businessId  String
  requestType String         // LEAVE, ATTENDANCE_CORRECTION, ADVANCE, OVERTIME
  referenceId String         // ID of the related object
  title       String
  details     String?        @db.Text
  status      ApprovalStatus @default(PENDING)
  actionById  String?
  actionNotes String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actionBy    User?          @relation("ActionBy", fields: [actionById], references: [id], onDelete: SetNull)
}

model PerformanceReview {
  id          String   @id @default(uuid())
  businessId  String
  employeeId  String
  reviewPeriod String  // Q3 2026, Annual 2026
  rating      Float    @default(5.0) // 1-5 scale
  feedback    String?  @db.Text
  reviewerName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model PerformanceGoal {
  id          String   @id @default(uuid())
  businessId  String
  employeeId  String
  title       String
  targetDate  DateTime?
  status      String   @default("IN_PROGRESS") // IN_PROGRESS, ACHIEVED, MISSED
  progressPct Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model GeoLocation {
  id          String   @id @default(uuid())
  businessId  String
  branchId    String?
  name        String   // Head Office, Factory Gate 1, Warehouse Ludhiana
  latitude    Float
  longitude   Float
  radiusMeters Float   @default(150)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String?
  userId     String?
  action     String   // PUNCH_IN, EDIT_SALARY, APPROVE_PAYROLL, etc.
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}
